.back-to-top
  position fixed
  bottom 32px
  right 48px
  border-radius 50%
  background rgba(255, 255, 255, 0.75)
  opacity 0
  transition:
      background 0.15s linear,
      opacity 0.15s linear
  width 50px
  height 50px
  z-index 2000
  cursor default
  
  &.is-visible
    opacity 1
    cursor pointer
  
  &:hover
    background white
    
.news-appear
  opacity 0

.news-appear-active
  transition-property: opacity;
  transition-duration: 0.25s;
  transition-delay: 0.25s;
  
.news-fade-enter-active
.news-fade-leave-active
  transition-property: opacity;
  transition-duration: .25s;

.news-fade-enter
.news-fade-leave-active
  opacity: 0
