
@import "fonts.styl"
@import "animations.styl"

ltlgMedia = "screen and (max-width: 991px)"
gtlgMedia = "screen and (min-width: 992px)"
ltMaxWidth = "screen and (min-width: 992px) and (max-width: 1509px)"
ltLaptopMedia = "screen and (max-width: 1365px)"
gtLaptopMedia = "screen and (min-width: 1366px)"
ltxxlMedia = "screen and (max-width: 1919px)"
xxlMedia = "screen and (min-width: 1920px)"

maxWidth = 1510px

appDefault = #2B2B2B
appGreen = #3b9c36
appGreenHover = #317c2c
appLightGreen = #8fc58b
appBlue = #2499D6
appBlueDark = #248dca

[v-cloak]
  display none
  
.transparent
  opacity 0

body
  font-family "Primary"
  font-weight 400
  color appDefault
  
h1
  font-size 96px
  line-height 112px
  font-weight 600
  
  @media ltlgMedia
    font-size 48px
    line-height 64px
  
h2
  font-size 48px
  line-height 56px
  color black
  
  &.with-dash
    position relative
    
    &:before
      content ''
      position absolute
      width 46px
      height 3px
      background appBlue
      top -20px
      left 6px
      
    &.distant-dash
      &:before
        top -48px
        left -2px
  
h3
  font-size 24px
  line-height 28px
  color appGreen
  //margin-top -24px
  margin-bottom 40px
  
p
  font-size 18px
  line-height 29px
  margin-bottom 29px
  
  a
    color appBlue
    text-decoration none !important
    
    &:hover
      color appBlueDark
      
p + h3
  margin-top 59px
  
table
  border none
  
  td
  th
    @extends p
    padding-bottom 29px
    padding-right 50px
    margin-bottom 0
    vertical-align top
    border none
    width auto !important
    
    @media ltLaptopMedia
      display block
      padding-right 0
    
    p
      margin-bottom 0
      
  tr
    th:last-child
    td:last-child
      padding-right 0
      
.button
  position relative
  display inline-block
  
  .button-text-container
    position absolute
    left 0
    top 0
    height 100%
    width 100%
    padding-left 34px
    font-size 18px
    color appDefault
    
  .more-arrow
    position absolute
    right -12px
    top 31px
    transition right 0.15s linear
    
  &:hover
    .more-arrow
      right -17px
    
.animated
  visibility hidden

#wrap
  min-height 100vh
  overflow-x hidden

.container-fluid
  max-width maxWidth
  
.narrow-container
  max-width 1366px
  
offsetPadding()
  padding-left 34px
  
.offset-container
  width 100%
  max-width calc(50% + 583px)
  offsetPadding()
  
header
  padding-top 140px
  
  .top-header
    position fixed
    top 0
    left 0
    width 100%
    z-index 2500
    background white
  
  .inner-header
    max-width 100%
    height 140px
    z-index 200
    
  .logo
    width 365px
    
    img
      width 100%
      
  .button-links
    margin-right 27px
    
    .button-link
      min-width 48px
      width 48px
      height 48px
      border-radius 24px
      text-transform uppercase
      padding 14px 15px
      color white
      margin-left 9px
      text-decoration none
      font-size 19px
      line-height 21px
      overflow hidden
      transition width 0.15s ease-out
      
      &.report
        background appGreen
      
      &.forms
        background appBlue
        
        .icon
          left 2px
        
        &:hover
          background appBlueDark
          
      .content
        white-space nowrap
        
        .icon
          margin-right 37px
          position relative
          top -1px
          transition:
            margin-left 0.15s ease-out,
            opacity 0.15s ease-out
        
        .text
          opacity 0
          white-space no-wrap
          transition opacity 0.15s ease-out
          
      &.expanded
        .content
          .icon
            margin-left -40px
            opacity 0
    
          .text
            opacity 1
      
  .nav-container
    padding-left 48px
    height 100%
    
    .main-links
      z-index 100
      height 100%
      
      .main-links-inner
        border-radius 24px
        border 1px solid appGreen
        transition border-color 0.15s linear
      
      &.menu-open
        .main-links-inner
          border-color white
        
        .item
          color white
          
          &:hover
            color rgba(255, 255, 255, 0.85)
            
          .hamburger
            .hamburger-inner
              background-color white

              &:before
              &:after
                background-color white
      
      .item
        height 48px
        padding 13px 20px 12px
        margin-left 13px
        color appGreen
        font-size 19px
        line-height 21px
        font-weight 400
        text-decoration none
        border 1px solid transparent
        transition color 0.15s linear
        
        &:hover
          color appGreenHover
          
        &.language
          margin-right 33px
        
        &.menu
          > span
            margin-right 14px
          
        .hamburger
          padding 1px 0 0
          height 20px
          outline none !important
          
          &:hover
            opacity 1
          
          &.is-active
            .hamburger-inner
              &:before
                top 0
                
              &:after
                bottom 0
                width 24px
                
          .hamburger-box
            width 24px
            height 20px
          
          .hamburger-inner
            background-color white
            border-radius 0
            width 24px
            height 3px
            
            &:before
            &:after
              height 3px
              width 24px
              border-radius 0
              background-color appGreen
              
            &:before
              top -5px
              
            &:after
              bottom -5px
              right 0
              width 12px
              
    .hidden-links-container
      position absolute
      display none
      top 0
      left 0
      width 100%
      z-index 50
      background appGreen
      max-height calc(100vh + 34px)
  
      .menu-cover
        width 100%
        height 140px
        background appGreen
        z-index 100
        position absolute
        left 0
        top 0
      
      .simplebar-scrollbar
        display none
      
      .inner-content
        padding 139px 62px 126px 62px
      
      ul
        list-style none
        padding 0
        margin 0
        
        a
        span
          color white

        span
          display inline-block

        a
          &:hover
            text-decoration none
            border-bottom 4px solid white
        
        &.top-level-list
          > li
            font-size 48px
            line-height 48px
            margin-bottom 24px
            
            &.active
              > a
                border-bottom 4px solid white
                
              > ul
                display block
            
            > ul
              display block
              padding 10px 0 10px 32px
              
              > li
                font-size 28px
                line-height 36px
                
                > a
                  &:hover
                    border-bottom 3px solid white
                  
      .info-container
        color white
        font-size 18px
        line-height 24px
        margin-top 70px
        
        p
          line-height 24px
        
        a
          color white
          
          &.cta-button
            text-decoration none
            background appBlue
            padding 12px 27px 10px
            border-radius 50px
            width 100%
            
            &:hover
              background appBlueDark
        
        .info-section
          .block
            width 100%
            max-width 280px
            margin-bottom 16px
  
            .with-padding
              padding-left 39px
            
            p
              margin-bottom 6px
    
              &:last-child
                margin-bottom 0
            
          .icon
            margin-right 15px
            position relative
            top -3px
            
            
