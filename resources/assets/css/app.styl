  .outer-section-container
    position relative
    margin 0 auto
    max-width 1920px
    
  .left-background-image
    position absolute
    left 0
    top -205px
  
  .content-container
    width 100%
    
    .inner-content-container
      width 100%
      margin-bottom 135px
      position relative
      transition margin-bottom 0.2s ease-out
      
      &.no-text-margin
        margin-bottom 0
  
    .text-container
      width 100%
      margin-bottom 26px
      padding-right 11px
      offsetPadding()
    
      &.narrow
        padding-right 125px
        
      &.narrower
        padding-right 172px
        
    .inner-text-container
      overflow hidden
      transition height 0.2s ease-out
      
      ul
        padding revert
        list-style initial
        font-size 18px
        
        span
          font-size initial
      
      h2
        font-size 36px
        
        a
          text-decoration none
          color appBlue
          
          &:hover
            color appBlueDark
      
      h2 + h2
